NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Transactional email (Resend)
RESEND_API_KEY=your-resend-api-key
# Verified sender — defaults to Resend's onboarding sandbox if unset
RESEND_FROM_EMAIL=FieldSlate <noreply@thefieldslate.com>

# Stripe (Item 13 — TEST MODE; leave blank until keys/prices are provisioned)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_SEASON_PRICE_ID=
STRIPE_ELITE_SEASON_PRICE_ID=

# Service-role key — server-only. Used by the Stripe webhook to apply plan +
# provision seasons without a user session (bypasses RLS). Never expose client-side.
SUPABASE_SERVICE_ROLE_KEY=
