NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Transactional email (Resend)
RESEND_API_KEY=your-resend-api-key
# Verified sender — defaults to Resend's onboarding sandbox if unset
RESEND_FROM_EMAIL=FieldSlate <noreply@thefieldslate.com>

# Stripe — LIVE MODE in production (real charges). Local dev may leave these
# blank; getStripe() constructs lazily and throws only when a handler runs.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_SEASON_PRICE_ID=
STRIPE_ELITE_SEASON_PRICE_ID=
# One-time $120 price (Elite − Pro difference) for Pro→Elite tier upgrades
STRIPE_ELITE_UPGRADE_FROM_PRO_PRICE_ID=
# Legacy fallback for the INTERLEAGUE promo — used only if the promo_codes
# table read errors. Promos are table-driven (see CLAUDE.md); don't add more.
STRIPE_INTERLEAGUE_COUPON_ID=

# Service-role key — server-only. Used by the Stripe webhook to apply plan +
# provision seasons without a user session (bypasses RLS). Never expose client-side.
SUPABASE_SERVICE_ROLE_KEY=
